<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "TeamQuest" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <nav class="topnav">
        <%= link_to "⚔️ TeamQuest", root_path, class: "brand" %>
        <div class="nav-links">
          <%= link_to "Roster", characters_path %>
          <%= link_to "Parties", teams_path %>
          <% if current_character %>
            <%= link_to "#{current_character.avatar} My Sheet", character_path(current_character), class: "nav-me" %>
          <% end %>
          <%= button_to "Log out", session_path, method: :delete, class: "linklike" %>
        </div>
      </nav>
    <% end %>

    <main class="container">
      <% if flash[:notice] %><div class="flash flash-notice"><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="flash flash-alert"><%= flash[:alert] %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
